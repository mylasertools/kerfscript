// A coaster with a ring of holes and a scored border.

/* [Coaster] */
// Shape
shape = "round"; // [round:Round, hex:Hexagon]
// Size in mm
size = 90; // [60:5:120]
// Holes in the ring
holes = 8; // [0:1:16]
// Scored border
border = true;

/* [Material] */
// Thickness in mm
$thickness = 3;
// Kerf in mm
$kerf = 0.15; // [0:0.01:0.3]

/* [Hidden] */
$fn = 96;

module outline(d) {
  if (shape == "hex") regular_polygon(6, d / 2);
  else circle(d = d);
}

difference() {
  outline(size);
  for (i = [0:holes - 1])
    rotate(i * 360 / max(holes, 1)) translate([size * 0.3, 0]) circle(d = size * 0.08);
}
if (border) score() outline(size - 8);
engrave() circle(d = size * 0.3);
