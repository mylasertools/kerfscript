// for, if, else, let and nested for build lists; a comprehension may be in parentheses
// => echo: [1, 4, 9], [1, 9], [-1, 4, 9], [0, 1, 2, 3], [0, 1, 2], [10, 0, 1]
echo([for (i = [1:3]) i * i], [for (i = [1:3]) if (i % 2) i * i], [for (i = [1:3]) let (s = i * i) if (s > 1) s else -1], [for (i = [0:1]) for (j = [0:1]) i * 2 + j], [(for (i = [0:2]) i)], [10, for (i = [0:1]) i]);
