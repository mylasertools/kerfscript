{
  "Module": {
    "prefix": "module",
    "body": ["module ${1:name}(${2}) {", "\t$0", "}"],
    "description": "Define a module that makes shapes"
  },
  "Function": {
    "prefix": "function",
    "body": ["function ${1:name}(${2}) = ${0:expr};"],
    "description": "Define a function"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for (${1:i} = [${2:0}:${3:5}]) {", "\t$0", "}"],
    "description": "Repeat statements over a range"
  },
  "If": {
    "prefix": "if",
    "body": ["if (${1:cond}) {", "\t$0", "}"],
    "description": "Conditional statement"
  },
  "Difference": {
    "prefix": "difference",
    "body": ["difference() {", "\t${1:rect([100, 60]);}", "\t$0", "}"],
    "description": "Subtract shapes from the first child"
  },
  "Part": {
    "prefix": "part",
    "body": ["part(\"${1:name}\", qty = ${2:1}) ${0:rect([100, 60]);}"],
    "description": "A named part for packing and export"
  },
  "Material": {
    "prefix": "material",
    "body": [
      "material(thickness = ${1:3}, kerf = ${2:0.15}, name = \"${3:plywood}\") {",
      "\t$0",
      "}"
    ],
    "description": "Set thickness, kerf and material name for its parts"
  },
  "Finger-jointed panel": {
    "prefix": "finger_rect",
    "body": ["finger_rect([${1:100}, ${2:60}], ${3|\"out\",\"in\",\"flat\"|});"],
    "description": "Rectangle with finger joints"
  },
  "Layer": {
    "prefix": ["score", "engrave"],
    "body": ["${1|score,engrave,guide|}() ${0:circle(d = 10);}"],
    "description": "Put shapes on the score, engrave or guide layer"
  },
  "Customizer group": {
    "prefix": "group",
    "body": ["/* [${1:Size}] */", "$0"],
    "description": "Start a group of settings in the customizer"
  },
  "Customizer slider": {
    "prefix": "slider",
    "body": ["${1:width} = ${2:120}; // [${3:40}:${4:5}:${5:400}]"],
    "description": "A setting shown as a slider"
  },
  "Use library": {
    "prefix": "use",
    "body": ["use <${1:kerf/box}>"],
    "description": "Import modules and functions from a library"
  }
}
