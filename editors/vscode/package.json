{
  "name": "kerfscript",
  "displayName": "KerfScript",
  "description": "KerfScript (.kerf), the programming language for laser cutting: highlighting, problems while you type, hover, completion, parameter hints, go to definition, references, rename, outline and formatting.",
  "version": "0.1.0",
  "publisher": "mylasertools",
  "license": "AGPL-3.0-only",
  "icon": "images/icon.png",
  "homepage": "https://kerfscript.mylasertools.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/mylasertools/kerfscript.git",
    "directory": "editors/vscode"
  },
  "bugs": "https://github.com/mylasertools/kerfscript/issues",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "kerfscript",
    "kerf",
    "laser cutting",
    "laser",
    "cnc",
    "cad",
    "parametric",
    "svg",
    "dxf",
    "openscad"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kerfscript",
        "aliases": [
          "KerfScript",
          "kerfscript",
          "kerf"
        ],
        "extensions": [
          ".kerf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/kerf-file-light.svg",
          "dark": "./images/kerf-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kerfscript",
        "scopeName": "source.kerfscript",
        "path": "./syntaxes/kerfscript.tmLanguage.json"
      },
      {
        "scopeName": "markdown.kerfscript.codeblock",
        "path": "./syntaxes/kerfscript.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.kerfscript": "kerfscript"
        }
      }
    ],
    "snippets": [
      {
        "language": "kerfscript",
        "path": "./snippets/kerfscript.json"
      }
    ],
    "configurationDefaults": {
      "[kerfscript]": {
        "editor.formatOnSave": true
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "vscode:prepublish": "node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\" && node build.mjs",
    "test": "node test/grammar.mjs && node test/parity.mjs && node test/server.mjs",
    "package": "vsce package",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0",
    "esbuild": "0.25.12",
    "ovsx": "^0.10.0",
    "vscode-languageclient": "9.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
