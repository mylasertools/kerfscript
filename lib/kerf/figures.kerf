// kerf/figures: layered characters for ornaments, standees, scenes and
// cards: Christmas, Easter, Halloween and nativity figures and animals.
// Copyright (c) 2026 MyLaserTools. AGPL-3.0-only or MyLaserTools commercial licence.
// The figures are drawn for this library; none is copied from other art.
//
// A figure is built in layers, as layered wood art is. The "outline" is a
// backer of its whole silhouette, a border wider than the rest. On it lie
// the coloured pieces of its "clothes" (a coat, for an animal) and its
// "face" (skin, bellies, beaks, ears), side by side with a thin gap between
// them, so the backer shows as lines. On those lie the "details": eyes,
// noses, buttons. Each layer comes in one or more colours.
//
// Each figure is drawn 100 units tall, standing on y = 0 and centred on
// x = 0, as a list of pieces in painter's order: each piece of clothes or
// face loses what the pieces after it cover. A piece is [layer, colour,
// shapes], the shapes a list of:
//   ["c", x, y, r]                       a circle
//   ["e", x, y, rx, ry, angle]           an ellipse, turned by angle
//   ["k", x1, y1, x2, y2, r1, r2]        a round-ended stroke from one end
//                                        to the other, r1 wide at the first
//                                        and r2 (r1 if left out) at the last
//   ["r", x, y, w, h, r, angle]          a rectangle round its centre, its
//                                        corners rounded by r
//   ["p", points]                        a polygon
//   ["s", points]                        a closed smooth curve through points
//   ["a", x, y, r, a0, a1, w]            an arc w wide, as a smile
//   ["m", shapes]                        the shapes and their mirror image
//   ["h", shapes]                        the hull of the shapes
//   ["-", shapes, minus]                 the shapes less the minus shapes

// The casts of figures
function figure_casts() = ["christmas", "easter", "halloween", "nativity", "animals"];

// The names of the figures, every one or those of one cast
function figure_names(cast) =
  assert(is_undef(cast) || len([for (c = figure_casts()) if (c == cast) c]) > 0,
    str("Unknown cast \"", cast, "\". Known: ", join(figure_casts(), ", ")))
  [for (f = FIGURES) if (is_undef(cast) || f[1] == cast) f[0]];

// A figure's entry: [name, cast, outline colour, pieces]
function figure_entry(name) =
  let (k = lower(name), hit = [for (f = FIGURES) if (f[0] == k) f])
  len(hit) ? hit[0] : assert(false, str("Unknown figure \"", name, "\". Known: ", join(figure_names(), ", ")));

// The parts a figure is built of, as [layer, colour], bottom up: the
// outline, then each colour of clothes and face, then of details
function figure_layers(name) =
  let (
    e = figure_entry(name),
    pieces = e[3],
    middle = figure_unique([for (p = pieces) if (p[0] != "details") [p[0], p[1]]]),
    top = figure_unique([for (p = pieces) if (p[0] == "details") [p[0], p[1]]])
  )
  concat([["outline", e[2]]], middle, top);

// The list without repeats, in the order first seen
function figure_unique(list) =
  [for (i = [0:len(list) - 1]) if (len([for (j = [0:i - 1]) if (i > 0 && list[j] == list[i]) 1]) == 0) list[i]];

// The shapes of a figure's piece list, in its own units
module figure_shapes(shapes) {
  for (q = shapes) {
    if (q[0] == "c") translate([q[1], q[2]]) circle(r = q[3]);
    else if (q[0] == "e") translate([q[1], q[2]]) rotate(is_undef(q[5]) ? 0 : q[5]) ellipse(r = [q[3], q[4]]);
    else if (q[0] == "k")
      hull() {
        translate([q[1], q[2]]) circle(r = q[5]);
        translate([q[3], q[4]]) circle(r = is_undef(q[6]) ? q[5] : q[6]);
      }
    else if (q[0] == "r")
      translate([q[1], q[2]]) rotate(is_undef(q[6]) ? 0 : q[6])
        rect([q[3], q[4]], center = true, r = min(is_undef(q[5]) ? 0 : q[5], q[3] / 2 - 0.01, q[4] / 2 - 0.01));
    else if (q[0] == "p") polygon(q[1]);
    else if (q[0] == "s") polygon(spline_points(q[1], closed = true));
    else if (q[0] == "a")
      stroke(q[6]) polyline([for (i = [0:16]) let (a = q[4] + (q[5] - q[4]) * i / 16) [q[1] + q[3] * cos(a), q[2] + q[3] * sin(a)]]);
    else if (q[0] == "m") {
      figure_shapes(q[1]);
      mirror([1, 0]) figure_shapes(q[1]);
    } else if (q[0] == "h") hull() figure_shapes(q[1]);
    else if (q[0] == "-")
      difference() {
        figure_shapes(q[1]);
        figure_shapes(q[2]);
      }
  }
}

// One layer of a figure: "outline", "clothes", "face" or "details", in
// every colour or only `color`. The outline is `height` mm tall, standing
// on y = 0 and centred on x = 0, `border` mm wider all round than the
// pieces on it; pieces of clothes and face keep `gap` mm apart, as do
// details, and lose any sliver narrower than `min_width` mm.
module figure_layer(name, layer, height = 100, color, border = 2, gap = 0.6, min_width = 1.6) {
  e = figure_entry(name);
  pieces = e[3];
  n = len(pieces);
  middle = [for (k = [0:n - 1]) if (pieces[k][0] != "details") k];
  assert(len([for (l = ["outline", "clothes", "face", "details"]) if (l == layer) l]) > 0,
    str("figure_layer(): layer must be \"outline\", \"clothes\", \"face\" or \"details\", got ", layer));
  assert(is_num(height) && height > 2 * border + 1, "figure_layer(): height must be more than twice the border");
  measure() {
    for (k = [0:n - 1]) figure_shapes(pieces[k][2]);
    let (b = $bounds, s = (height - 2 * border) / (b[3] - b[1]), at = [-(b[0] + b[2]) / 2, -b[1]]) {
      if (layer == "outline") {
        offset(r = border) translate([0, border]) scale(s) translate(at)
          for (k = [0:n - 1]) figure_shapes(pieces[k][2]);
      } else {
        // Each piece loses what the pieces after it on its layer cover, a
        // gap wider, and anything narrower than min_width; details stay on
        // the clothes and face
        same = [for (k = [0:n - 1]) if ((pieces[k][0] == "details") == (layer == "details")) k];
        for (k = same)
          if ((layer == "details" || pieces[k][0] == layer) && (is_undef(color) || pieces[k][1] == color))
            offset(r = min_width / 2) offset(r = -min_width / 2)
              difference() {
                intersection() {
                  translate([0, border]) scale(s) translate(at) figure_shapes(pieces[k][2]);
                  if (layer == "details")
                    offset(delta = -gap) translate([0, border]) scale(s) translate(at)
                      for (j = middle) figure_shapes(pieces[j][2]);
                }
                offset(delta = gap) translate([0, border]) scale(s) translate(at)
                  for (j = same) if (j > k) figure_shapes(pieces[j][2]);
              }
      }
    }
  }
}

// A figure cut from one sheet, `height` mm tall: its outline cut, the
// lines between its coloured pieces scored and its details engraved
module figure(name, height = 100, border = 2, gap = 0.6) {
  figure_layer(name, "outline", height, border = border, gap = gap);
  score() for (l = ["clothes", "face"]) outline() figure_layer(name, l, height, border = border, gap = gap);
  engrave() figure_layer(name, "details", height, border = border, gap = gap);
}

// A figure as layered parts, `height` mm tall: the outline at `at`, turned
// by `rotate`, its clothes and face glued on it and its details on those,
// one part for each colour of each layer, painted that colour. The parts
// are named after `label` (the figure's name), as "bunny face pink".
module figure_parts(name, height = 100, at = [0, 0, 0], rotate = [0, 0, 0], label, border = 2, gap = 0.6, qty = 1) {
  base = is_undef(label) ? lower(name) : label;
  layers = figure_layers(name);
  middle = [for (l = layers) if (l[0] == "clothes" || l[0] == "face") l];
  part(str(base, " outline"), qty = qty, at = at, rotate = rotate, paint = layers[0][1])
    figure_layer(name, "outline", height, border = border, gap = gap);
  // A part too small to cut at this height is left out
  for (l = middle)
    measure() {
      figure_layer(name, l[0], height, l[1], border = border, gap = gap);
      if (!is_undef($bounds))
        part(str(base, " ", l[0], " ", l[1]), qty = qty, glue = str(base, " outline"), paint = l[1], pieces = "any")
          figure_layer(name, l[0], height, l[1], border = border, gap = gap);
    }
  figure_details(name, height, base, qty, border, gap);
}

// A figure's details as painted parts named after `base`, glued on the
// first of its clothes and face parts, from the `k`-th, that is big enough
// to cut at this height
module figure_details(name, height, base, qty = 1, border = 2, gap = 0.6, k = 0) {
  layers = figure_layers(name);
  middle = [for (l = layers) if (l[0] == "clothes" || l[0] == "face") l];
  if (k < len(middle))
    measure() {
      figure_layer(name, middle[k][0], height, middle[k][1], border = border, gap = gap);
      if (is_undef($bounds)) figure_details(name, height, base, qty, border, gap, k + 1);
      else
        for (l = layers)
          if (l[0] == "details")
            measure() {
              figure_layer(name, "details", height, l[1], border = border, gap = gap);
              if (!is_undef($bounds))
                part(str(base, " details ", l[1]), qty = qty, glue = str(base, " ", middle[k][0], " ", middle[k][1]), paint = l[1], pieces = "any")
                  figure_layer(name, "details", height, l[1], border = border, gap = gap);
            }
    }
}

