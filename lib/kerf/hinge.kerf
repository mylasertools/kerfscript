// kerf/hinge: living hinges, for bending flat sheet around a corner.
// Copyright (c) 2026 MyLaserTools. AGPL-3.0-only or MyLaserTools commercial licence.

use <kerf/tabs>

// Length of living hinge that bends `angle` degrees around an inside
// radius `r`: the arc along the middle of the sheet.
function bend_length(r, angle = 90) = PI * (r + $thickness / 2) * angle / 180;

// A rectangle that bends: a living hinge across its full height at each x
// in `bends`, centred there and `width` wide. The width defaults to a
// 90° bend around three thicknesses; `r` rounds the corners.
module flex_rect(size, bends, width = undef, spacing = 1.5, bridge = 3, r = 0) {
  w = is_undef(width) ? bend_length(3 * $thickness) : width;
  rect(size, r = r);
  for (x = bends)
    translate([x - w / 2, 0]) living_hinge([w, size[1]], spacing = spacing, bridge = bridge);
}

// Box with rounded corners whose four sides are one strip, bent at the
// corners by living hinges. The bottom's tabs go through slots in the
// strip; the lid rests on top, kept in place by an insert glued under it.
// `size` is the outside [width, depth, height], lid included, and `r` the
// outside corner radius, more than two thicknesses.
module flex_box(size, r = 15, lid = true, clearance = 0.1, spacing = 1.5, bridge = 3) {
  t = $thickness;
  w = size[0];
  d = size[1];
  h = lid ? size[2] - t : size[2];
  assert(r > 2 * t, "r must be more than two thicknesses");
  assert(w >= 2 * r && d >= 2 * r, "width and depth must be at least 2 * r");
  // Straight runs and the bends at the corners, measured along the strip
  sw = w - 2 * r;
  sd = d - 2 * r;
  b = bend_length(r - t);
  L = 2 * sw + 2 * sd + 4 * b;
  // The strip starts in the middle of the front and goes round
  // anticlockwise seen from above: where each run starts, and its length
  runs = [[-sw / 2, sw], [sw / 2 + b, sd], [sw / 2 + 2 * b + sd, sw], [1.5 * sw + 3 * b + sd, sd]];
  bends = [sw / 2 + b / 2, sw / 2 + 1.5 * b + sd, 1.5 * sw + 2.5 * b + sd, 1.5 * sw + 3.5 * b + 2 * sd];
  // The strip stands round the bottom, its outer face out, bending in at
  // each corner; it starts in the middle of the front
  part("side", at = [w / 2, t, 0], rotate = orient([1, 0, 0], [0, -1, 0]), bend = [for (c = bends) [c - b / 2, c + b / 2, -90]]) difference() {
    flex_rect([L, h], bends, width = b, spacing = spacing, bridge = bridge);
    // The front run crosses the ends: its slots are cut at both
    for (run = runs, o = [0, L])
      if (run[1] > 0) translate([run[0] + o, 1.5 * t]) slots(run[1], clearance = clearance);
  }
  part("bottom", at = [t, t, t]) flex_panel([w - 2 * t, d - 2 * t], r - t, sw, sd);
  if (lid) {
    part("lid", at = [0, 0, h]) rect([w, d], r = r);
    part("lid insert", at = [t, t, h - t])
      offset(delta = -clearance) rect([w - 2 * t, d - 2 * t], r = r - t);
  }
}

// The bottom of flex_box(): a rounded rectangle with tabs on its straight
// runs, `sw` long on the front and back and `sd` on the sides.
module flex_panel(size, r, sw, sd) {
  rect(size, r = r);
  if (sw > 0) {
    translate([r, 0]) tabs(sw);
    translate([r + sw, size[1]]) rotate(180) tabs(sw);
  }
  if (sd > 0) {
    translate([size[0], r]) rotate(90) tabs(sd);
    translate([0, r + sd]) rotate(270) tabs(sd);
  }
}

// A hinge for a narrow strap or band: cuts from alternate edges, `spacing`
// apart, each stopping `bridge` short of the far edge, so the strip
// zigzags and bends evenly however narrow it is. Lines, across [w, h].
module narrow_hinge(size, spacing = 1.5, bridge = 1.5) {
  w = size[0];
  h = size[1];
  n = max(1, floor(w / spacing));
  for (i = [0:n]) let (x = i * w / n)
    if (i % 2 == 0) line([x, -1], [x, h - bridge]); else line([x, bridge], [x, h + 1]);
}

// The bends of a strip that follows `path`, a list of [x, y] points along
// its middle: [s0, s1, angle] for each curve, measured along the path,
// turning left positive. Segments shorter than `straight` are curve, the
// rest straight; a sharp corner bends round radius `r`. A curve whose
// radius changes, as a tight fillet running into a wide arc, is several
// bends end to end, one for each stretch of much the same radius.
function strip_bends(path, straight = 10, r = undef) =
  let (
    rr = is_undef(r) ? 2 * $thickness : r,
    // A point repeated, as where a straight run and an arc share their end,
    // has no heading of its own: it is left out
    pts = [for (i = [0:len(path) - 1]) if (i == 0 || norm(path[i] - path[i - 1]) > 1e-9) path[i]],
    n = len(pts),
    segs = [for (i = [0:n - 2]) norm(pts[i + 1] - pts[i])],
    at = [for (i = [0:n - 1]) i == 0 ? 0 : sum([for (k = [0:i - 1]) segs[k]])],
    head = [for (i = [0:n - 2]) atan2(pts[i + 1][1] - pts[i][1], pts[i + 1][0] - pts[i][0])],
    turn = [for (i = [1:n - 2]) let (d = head[i] - head[i - 1]) d > 180 ? d - 360 : d < -180 ? d + 360 : d],
    // Each corner as [s0, s1, angle]: a short segment's turn spreads over
    // it, a sharp corner's over a bend of radius rr
    corners = [for (i = [1:n - 2]) if (abs(turn[i - 1]) > 0.01)
      let (short_in = segs[i - 1] < straight, short_out = segs[i] < straight,
        half = PI * (rr + $thickness / 2) * abs(turn[i - 1]) / 360,
        s0 = short_in ? at[i] - segs[i - 1] / 2 : at[i] - half,
        s1 = short_out ? at[i] + segs[i] / 2 : at[i] + half)
        [s0, s1, turn[i - 1]]]
  )
  strip_join(corners);

// Joins bends that touch or overlap into one where they turn the same way
// at much the same rate (within a quarter), so each bend keeps close to
// one radius. Two that overlap but don't join meet halfway through the
// overlap.
function strip_join(list, i = 0, cur = undef, out = []) =
  i == len(list) ? (is_undef(cur) ? out : concat(out, [cur]))
  : is_undef(cur) ? strip_join(list, i + 1, list[i], out)
  : let (nx = list[i]) nx[0] > cur[1] + 0.01 ? strip_join(list, i + 1, nx, concat(out, [cur]))
  : let (p = cur[2] / (cur[1] - cur[0]), q = nx[2] / (nx[1] - nx[0]),
    alike = p * q > 0 && max(abs(p), abs(q)) <= 1.25 * min(abs(p), abs(q)))
  // Alike, or one within the other: one bend
  alike || nx[0] <= cur[0] || nx[1] <= cur[1]
  ? strip_join(list, i + 1, [cur[0], max(cur[1], nx[1]), cur[2] + nx[2]], out)
  : nx[0] >= cur[1] ? strip_join(list, i + 1, nx, concat(out, [cur]))
  : let (m = (nx[0] + cur[1]) / 2) strip_join(list, i + 1, [m, nx[1], nx[2]], concat(out, [[cur[0], m, cur[2]]]));

// Joins bends that touch or overlap into one
function strip_merge(list, i = 0, cur = undef, out = []) =
  i == len(list) ? (is_undef(cur) ? out : concat(out, [cur]))
  : is_undef(cur) ? strip_merge(list, i + 1, list[i], out)
  : list[i][0] <= cur[1] + 0.01 ? strip_merge(list, i + 1, [cur[0], max(cur[1], list[i][1]), cur[2] + list[i][2]], out)
  : strip_merge(list, i + 1, list[i], concat(out, [cur]));

// A strip of the current material that follows `path` in a plate's plane,
// `width` wide, with living hinges where it curves and tabs along both
// edges where it runs straight, as a part placed in the plate's own
// coordinates: its edge at z = 0 and its width running down to z =
// -width. Put it in place() with the plate's at and rotate, set the other
// plate `width` below, and give both plates slots = [name]: they cut their
// own slots for the tabs. The 3D view shows the strip bent.
module flex_strip(path, width, name = "strip", tabs = true, straight = 10, r = undef, spacing = 1.5, bridge = 3, narrow = false) {
  t = $thickness;
  L = path_length(path);
  bends = strip_bends(path, straight, r);
  // The hinges are cut over each stretch of bends end to end
  spans = strip_merge(bends);
  h0 = heading_at(path, 0);
  p0 = path[0] - t / 2 * [-sin(h0), cos(h0)];
  runs = [for (k = [0:len(spans)]) [k == 0 ? 0 : spans[k - 1][1], k == len(spans) ? L : spans[k][0]]];
  part(name, at = [p0[0], p0[1], 0], rotate = orient([cos(h0), sin(h0), 0], [-sin(h0), cos(h0), 0]), bend = [for (b = bends) [b[0], b[1], b[2]]]) {
    rect([L, width]);
    for (b = spans) translate([b[0], 0])
      if (narrow) narrow_hinge([b[1] - b[0], width], spacing, bridge);
    else living_hinge([b[1] - b[0], width], spacing = spacing, bridge = bridge);
    if (tabs)
      for (run = runs) if (run[1] - run[0] > 16)
        let (len_ = run[1] - run[0] - 6, w = min(20, len_ / 3), n = max(1, round(len_ / 50)))
          for (x = tab_positions(len_, n)) {
            translate([run[0] + 3 + x - w / 2, -t]) rect([w, t + 0.01]);
            translate([run[0] + 3 + x - w / 2, width - 0.01]) rect([w, t + 0.01]);
          }
  }
}

// The part of `path` from s0 to s1 along it, its ends where those fall
function path_part(path, s0, s1) =
  let (at = concat([0], scan([for (i = [0:len(path) - 2]) norm(path[i + 1] - path[i])], 0, function(a, x) a + x)))
  concat([point_at(path, s0)], [for (i = [0:len(path) - 1]) if (at[i] > s0 + 1e-6 && at[i] < s1 - 1e-6) path[i]], [point_at(path, s1)]);

// A closed outline as a path round it that starts and ends at the point
// of it nearest `join` (its first point when join is undef)
function wall_path(outline, join = undef) =
  let (
    n = len(outline),
    pts = norm(outline[n - 1] - outline[0]) < 1e-9 ? slice(outline, 0, n - 1) : outline,
    m = len(pts),
    near = [for (i = [0:m - 1]) let (a = pts[i], b = pts[(i + 1) % m], d = b - a,
      u = is_undef(join) ? 0 : clamp(((join - a) * d) / max(d * d, 1e-12), 0, 1)) [a + u * d, is_undef(join) ? 0 : norm(join - a - u * d)]],
    k = fold([for (i = [0:m - 1]) i], 0, function(b, i) near[i][1] < near[b][1] ? i : b),
    ring = concat([near[k][0]], [for (i = [1:m]) pts[(k + i) % m]], [near[k][0]])
  )
  [for (i = [0:len(ring) - 1]) if (i == 0 || norm(ring[i] - ring[i - 1]) > 1e-9) ring[i]];

// Where to split a strip L long into n pieces no longer than max_length:
// near even spacing, at the middle of a straight run where one is near,
// else at the middle of a segment of the path, where its bends end
function wall_splits(L, n, max_length, mids, halves, k = 1, prev = 0, out = []) =
  k >= n ? out
  : let (t = k * L / n,
    fits = function(list) [for (c = list) if (c > prev + 1 && c <= prev + max_length && L - c <= (n - k) * max_length) c],
    nearest = function(list) fold(list, list[0], function(b, x) abs(x - t) < abs(b - t) ? x : b),
    ok = fits(mids), half = fits(halves),
    c = len(ok) ? nearest(ok) : len(half) ? nearest(half) : t)
  wall_splits(L, n, max_length, mids, halves, k + 1, c, concat(out, [c]));

// The names of the pieces of the strip wall() makes
function wall_strip_names(name, pieces) = pieces == 1 ? [str(name, " strip")] : [for (k = [1:pieces]) str(name, " strip ", k)];

// How many pieces wall() cuts its strip into
function wall_pieces(outline, max_length = 400, join = undef) = max(1, ceil(path_length(wall_path(outline, join)) / max_length));

// A wall round a closed outline: a front plate, a back plate `depth`
// behind it and a strip between them that follows the outline, bent on
// living hinges where it curves and tabbed into slots in both plates where
// it runs straight. The strip's ends meet at the point of the outline
// nearest `join`; a strip longer than `max_length` is cut into pieces no
// longer, split where it runs straight when it can, so each fits the bed.
//
// The first child, when given, is the front plate, drawn as the outline
// is; the second the back plate. Without them each plate is the outline
// grown by `rim` (half a thickness and 3 mm). Where the strip's ends meet
// they are `seam` apart, so pieces bent on their hinges don't press on
// each other. The parts are
// str(name, " front"), str(name, " back") and str(name, " strip"), or
// " strip 1", " strip 2" and so on for a strip in pieces. It stands
// upright as placed by `at` and `rotate`: the outline is seen from the
// front, the back plate behind it.
module wall(outline, depth, name = "wall", join = undef, max_length = 400, rim = undef, seam = 0.3, tabs = true, straight = 10, r = undef, spacing = 1.5, bridge = 3, narrow = false, at = [0, 0, 0], rotate = [90, 0, 0]) {
  t = $thickness;
  grow = is_undef(rim) ? t / 2 + 3 : rim;
  path = wall_path(outline, join);
  L = path_length(path);
  n = max(1, ceil(L / max_length));
  spans = strip_merge(strip_bends(path, straight, r));
  runs = [for (k = [0:len(spans)]) [k == 0 ? 0 : spans[k - 1][1], k == len(spans) ? L : spans[k][0]]];
  mids = [for (run = runs) if (run[1] - run[0] >= 2 * straight) (run[0] + run[1]) / 2];
  at_ = concat([0], scan([for (i = [0:len(path) - 2]) norm(path[i + 1] - path[i])], 0, function(a, x) a + x));
  halves = [for (i = [0:len(path) - 2]) (at_[i] + at_[i + 1]) / 2];
  cuts = concat([0], wall_splits(L, n, max_length, mids, halves), [L]);
  names = wall_strip_names(name, n);
  pieces = [for (k = [0:n - 1]) path_part(path, cuts[k] + seam / 2, cuts[k + 1] - seam / 2)];
  // The pieces with tabs, as flex_strip() puts them on runs over 16 mm
  tabbed = !tabs ? [] : [for (k = [0:n - 1]) let (sp = strip_merge(strip_bends(pieces[k], straight, r)), l = path_length(pieces[k]),
    rs = [for (j = [0:len(sp)]) (j == len(sp) ? l : sp[j][0]) - (j == 0 ? 0 : sp[j - 1][1])]) if (max(rs) > 16) names[k]];
  place(at = at, rotate = rotate) {
    part(str(name, " front"), slots = tabbed) {
      if ($children > 0) children(0);
      else offset(delta = grow) polygon(outline);
    }
    part(str(name, " back"), at = [0, 0, -depth - t], slots = tabbed) {
      if ($children > 1) children(1);
      else offset(delta = grow) polygon(outline);
    }
    for (k = [0:n - 1])
      flex_strip(pieces[k], depth, name = names[k], tabs = tabs, straight = straight, r = r, spacing = spacing, bridge = bridge, narrow = narrow);
  }
}
