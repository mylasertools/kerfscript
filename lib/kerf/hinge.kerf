// kerf/hinge: living hinges, for bending flat sheet around a corner.
// Copyright (c) 2026 MyLaserTools. AGPL-3.0-only or MyLaserTools commercial licence.

use <kerf/tabs>

// Length of living hinge that bends `angle` degrees around an inside
// radius `r`: the arc along the middle of the sheet.
function bend_length(r, angle = 90) = PI * (r + $thickness / 2) * angle / 180;

// A rectangle that bends: a living hinge across its full height at each x
// in `bends`, centred there and `width` wide. The width defaults to a
// 90° bend around three thicknesses; `r` rounds the corners.
module flex_rect(size, bends, width = undef, spacing = 1.5, bridge = 3, r = 0) {
  w = is_undef(width) ? bend_length(3 * $thickness) : width;
  rect(size, r = r);
  for (x = bends)
    translate([x - w / 2, 0]) living_hinge([w, size[1]], spacing = spacing, bridge = bridge);
}

// Box with rounded corners whose four sides are one strip, bent at the
// corners by living hinges. The bottom's tabs go through slots in the
// strip; the lid rests on top, kept in place by an insert glued under it.
// `size` is the outside [width, depth, height], lid included, and `r` the
// outside corner radius, more than two thicknesses.
module flex_box(size, r = 15, lid = true, clearance = 0.1, spacing = 1.5, bridge = 3) {
  t = $thickness;
  w = size[0];
  d = size[1];
  h = lid ? size[2] - t : size[2];
  assert(r > 2 * t, "r must be more than two thicknesses");
  assert(w >= 2 * r && d >= 2 * r, "width and depth must be at least 2 * r");
  // Straight runs and the bends at the corners, measured along the strip
  sw = w - 2 * r;
  sd = d - 2 * r;
  b = bend_length(r - t);
  L = 2 * sw + 2 * sd + 4 * b;
  // The strip starts in the middle of the front and goes round
  // anticlockwise seen from above: where each run starts, and its length
  runs = [[-sw / 2, sw], [sw / 2 + b, sd], [sw / 2 + 2 * b + sd, sw], [1.5 * sw + 3 * b + sd, sd]];
  bends = [sw / 2 + b / 2, sw / 2 + 1.5 * b + sd, 1.5 * sw + 2.5 * b + sd, 1.5 * sw + 3.5 * b + 2 * sd];
  // The strip stands round the bottom, its outer face out, bending in at
  // each corner; it starts in the middle of the front
  part("side", at = [w / 2, t, 0], rotate = orient([1, 0, 0], [0, -1, 0]), bend = [for (c = bends) [c - b / 2, c + b / 2, -90]]) difference() {
    flex_rect([L, h], bends, width = b, spacing = spacing, bridge = bridge);
    // The front run crosses the ends: its slots are cut at both
    for (run = runs, o = [0, L])
      if (run[1] > 0) translate([run[0] + o, 1.5 * t]) slots(run[1], clearance = clearance);
  }
  part("bottom", at = [t, t, t]) flex_panel([w - 2 * t, d - 2 * t], r - t, sw, sd);
  if (lid) {
    part("lid", at = [0, 0, h]) rect([w, d], r = r);
    part("lid insert", at = [t, t, h - t])
      offset(delta = -clearance) rect([w - 2 * t, d - 2 * t], r = r - t);
  }
}

// The bottom of flex_box(): a rounded rectangle with tabs on its straight
// runs, `sw` long on the front and back and `sd` on the sides.
module flex_panel(size, r, sw, sd) {
  rect(size, r = r);
  if (sw > 0) {
    translate([r, 0]) tabs(sw);
    translate([r + sw, size[1]]) rotate(180) tabs(sw);
  }
  if (sd > 0) {
    translate([size[0], r]) rotate(90) tabs(sd);
    translate([0, r + sd]) rotate(270) tabs(sd);
  }
}

// A hinge for a narrow strap or band: cuts from alternate edges, `spacing`
// apart, each stopping `bridge` short of the far edge, so the strip
// zigzags and bends evenly however narrow it is. Lines, across [w, h].
module narrow_hinge(size, spacing = 1.5, bridge = 1.5) {
  w = size[0];
  h = size[1];
  n = max(1, floor(w / spacing));
  for (i = [0:n]) let (x = i * w / n)
    if (i % 2 == 0) line([x, -1], [x, h - bridge]); else line([x, bridge], [x, h + 1]);
}

// The bends of a strip that follows `path`, a list of [x, y] points along
// its middle: [s0, s1, angle] for each curve, measured along the path,
// turning left positive. Segments shorter than `straight` are curve, the
// rest straight; a sharp corner bends round radius `r`.
function strip_bends(path, straight = 10, r = undef) =
  let (
    rr = is_undef(r) ? 2 * $thickness : r,
    n = len(path),
    segs = [for (i = [0:n - 2]) norm(path[i + 1] - path[i])],
    at = [for (i = [0:n - 1]) i == 0 ? 0 : sum([for (k = [0:i - 1]) segs[k]])],
    head = [for (i = [0:n - 2]) atan2(path[i + 1][1] - path[i][1], path[i + 1][0] - path[i][0])],
    turn = [for (i = [1:n - 2]) let (d = head[i] - head[i - 1]) d > 180 ? d - 360 : d < -180 ? d + 360 : d],
    // Each corner as [s0, s1, angle]: a short segment's turn spreads over
    // it, a sharp corner's over a bend of radius rr
    corners = [for (i = [1:n - 2]) if (abs(turn[i - 1]) > 0.01)
      let (short_in = segs[i - 1] < straight, short_out = segs[i] < straight,
        half = PI * (rr + $thickness / 2) * abs(turn[i - 1]) / 360,
        s0 = short_in ? at[i] - segs[i - 1] / 2 : at[i] - half,
        s1 = short_out ? at[i] + segs[i] / 2 : at[i] + half)
        [s0, s1, turn[i - 1]]]
  )
  strip_merge(corners);

// Joins bends that touch or overlap into one
function strip_merge(list, i = 0, cur = undef, out = []) =
  i == len(list) ? (is_undef(cur) ? out : concat(out, [cur]))
  : is_undef(cur) ? strip_merge(list, i + 1, list[i], out)
  : list[i][0] <= cur[1] + 0.01 ? strip_merge(list, i + 1, [cur[0], max(cur[1], list[i][1]), cur[2] + list[i][2]], out)
  : strip_merge(list, i + 1, list[i], concat(out, [cur]));

// A strip of the current material that follows `path` in a plate's plane,
// `width` wide, with living hinges where it curves and tabs along both
// edges where it runs straight, as a part placed in the plate's own
// coordinates: its edge at z = 0 and its width running down to z =
// -width. Put it in place() with the plate's at and rotate, set the other
// plate `width` below, and give both plates slots = [name]: they cut their
// own slots for the tabs. The 3D view shows the strip bent.
module flex_strip(path, width, name = "strip", tabs = true, straight = 10, r = undef, spacing = 1.5, bridge = 3, narrow = false) {
  t = $thickness;
  L = path_length(path);
  bends = strip_bends(path, straight, r);
  h0 = heading_at(path, 0);
  p0 = path[0] - t / 2 * [-sin(h0), cos(h0)];
  runs = [for (k = [0:len(bends)]) [k == 0 ? 0 : bends[k - 1][1], k == len(bends) ? L : bends[k][0]]];
  part(name, at = [p0[0], p0[1], 0], rotate = orient([cos(h0), sin(h0), 0], [-sin(h0), cos(h0), 0]), bend = [for (b = bends) [b[0], b[1], b[2]]]) {
    rect([L, width]);
    for (b = bends) translate([b[0], 0])
      if (narrow) narrow_hinge([b[1] - b[0], width], spacing, bridge);
    else living_hinge([b[1] - b[0], width], spacing = spacing, bridge = bridge);
    if (tabs)
      for (run = runs) if (run[1] - run[0] > 16)
        let (len_ = run[1] - run[0] - 6, w = min(20, len_ / 3), n = max(1, round(len_ / 50)))
          for (x = tab_positions(len_, n)) {
            translate([run[0] + 3 + x - w / 2, -t]) rect([w, t + 0.01]);
            translate([run[0] + 3 + x - w / 2, width - 0.01]) rect([w, t + 0.01]);
          }
  }
}
