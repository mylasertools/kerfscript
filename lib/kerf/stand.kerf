// kerf/stand: a sign, a photo or a calendar standing in a base.
// Copyright (c) 2026 MyLaserTools. AGPL-3.0-only or MyLaserTools commercial licence.
//
// The panel has tabs along its bottom edge that go through slots in a
// base, upright or leaning back. stand() makes both parts and puts them
// together; stand_tabs() and stand_slots() are the two halves of the joint
// for a base of your own, and match whenever they are given the same
// width, count, tab and lean. The base is $thickness thick, as the panel.

use <kerf/tabs>

// The panel `width` wide drawn by the children, its bottom edge on y = 0
// from x = 0, standing in a base `depth` deep and `margin` wider than it
// on each side, leaning back by `lean` degrees. Its back face meets the
// base `back` from the front, half way by default. The parts are `name`
// and "`name` stand".
module stand(width, depth = 40, count = undef, tab = undef, lean = 0, margin = 10, back = undef, r = 3, clearance = 0.1, name = "Sign") {
  t = $thickness;
  assert(width > 0, "stand(): width must be more than 0");
  assert(lean >= 0 && lean < 45, "stand(): lean is from 0 up to 45 degrees");
  ys = is_undef(back) ? depth / 2 : back;
  assert(ys > 0 && ys < depth, "stand(): back must be inside the base's depth");
  part(name, at = [0, ys, t], rotate = [90 - lean, 0, 0]) {
    children();
    stand_tabs(width, count, tab, lean);
  }
  part(str(name, " stand"), at = [0, 0, 0]) difference() {
    translate([-margin, 0]) rect([width + 2 * margin, depth], r = r);
    translate([0, ys]) stand_slots(width, count, tab, lean, clearance);
  }
}

// Tabs for the bottom edge of a panel `width` wide, x from 0 to `width`,
// hanging below y = 0 far enough to go through a base $thickness thick
// when the panel leans back by `lean` degrees. Each is `tab` wide, half
// the space between tabs by default; `count` is one for every 50 mm.
module stand_tabs(width, count = undef, tab = undef, lean = 0) {
  at = tab_positions(width, count);
  w = is_undef(tab) ? width / (2 * len(at)) : tab;
  d = $thickness / cos(lean);
  for (x = at) translate([x - w / 2, -d]) rect([w, d + 0.01]);
}

// The slots in a base for stand_tabs() with the same width, count, tab
// and lean, x from 0 to `width`, for a panel whose back face meets the top
// of the base on y = 0, standing towards -y and leaning back towards +y.
// `clearance` is added to each slot's width and depth.
module stand_slots(width, count = undef, tab = undef, lean = 0, clearance = 0.1) {
  at = tab_positions(width, count);
  w = is_undef(tab) ? width / (2 * len(at)) : tab;
  t = $thickness;
  // from the back face at the top to the tab's front corner at its end
  across = t * cos(lean) + t * tan(lean);
  for (x = at) translate([x, -across / 2]) rect([w + clearance, across + clearance], center = true);
}
