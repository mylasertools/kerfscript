// A pair of spur gears with involute teeth, cut from one sheet, made with
// spur_gear() from kerf/gears.

/* [Gears] */
// Teeth on the large gear
teeth_large = 32; // [12:1:80]
// Teeth on the small gear
teeth_small = 14; // [8:1:40]
// Tooth size (module) in mm
tooth = 3; // [1.5:0.25:6]
// Pressure angle
pressure = 20; // [14.5, 20, 25]

/* [Hub] */
// Shaft hole diameter
bore = 6; // [2:0.5:20]
// Lightening holes in gears with this many teeth or more
spokes_from = 24; // [12:1:100]

/* [Hidden] */
$fn = 96;

use <kerf/gears>

// Assembled: the two gears in mesh, the small one turned to fit between
// the large one's teeth
step("Put the large gear on its axle")
  part("large gear", at = [0, 0, 0])
    spur_gear(teeth_large, tooth, bore, pressure, spokes = teeth_large >= spokes_from ? 5 : 0);
step("Put the small gear on its axle, in mesh")
  part("small gear", at = [gear_distance(teeth_large, teeth_small, tooth), 0, 0], rotate = [0, 0, gear_phase(teeth_small)])
    spur_gear(teeth_small, tooth, bore, pressure, spokes = teeth_small >= spokes_from ? 5 : 0);
for (x = [0, gear_distance(teeth_large, teeth_small, tooth)])
  hardware("dowel", [x, 0, -10], [x, 0, $thickness + 10], bore, label = "axle");
