// Sector stand: a tilting deck on two trunnions, locked through curved slots.
// Glue the fixed cheeks into the foot, and the moving flanges and front lip
// into the deck. Bolt each flange to its cheek at the pivot and arc slot.
// Loosen both arc bolts before adjusting, then tighten them again.

use <kerf/tabs>

/* [Stand] */
width = 180; // [130:5:260]
depth = 130; // [110:5:190]
base_depth = 190; // [165:5:250]
pivot_height = 65; // [55:5:90]
radius = 78; // [65:1:100]
angle = 35; // [10:1:65]
lip_height = 18; // [14:1:25]

/* [Material] */
$thickness = 3; // [2:0.5:6]
$kerf = 0.15; // [0:0.01:0.3]
clearance = 0.15; // [0:0.05:0.4]
bolt_diameter = 4; // [3:0.5:5]
washer_gap = 0.6; // [0.3:0.1:1]

/* [Hidden] */
$material = "plywood";
t=$thickness;
py=25;
v=10;
assert(angle>=10 && angle<=65,"Keep the deck within the arc-slot limits");
assert(radius<depth-20,"Keep the clamp pivot inside the flange");
assert(base_depth>py+radius+18,"Lengthen the foot under the arc cheeks");
assert(pivot_height>2*t+24,"Raise the deck above the foot");
function arc(a,r=radius) = [py+r*cos(a),pivot_height-t+r*sin(a)];
function moving(u,z=0) = [0,py+u*cos(angle)-z*sin(angle),pivot_height+u*sin(angle)+z*cos(angle)];
function fixed_x(s) = s<0?-width/2-washer_gap-t:width/2+washer_gap;
function flange_x(s) = s<0?-width/2+4:width/2-4-t;
part("Foot",at=[0,0,0]) difference() {
  translate([-(width+4*t+12)/2,0])rect([width+4*t+12,base_depth],r=5);
  for(s=[-1,1],y=[40,base_depth-40])translate([fixed_x(s)+t/2,y])rect([t+clearance,20+clearance],center=true);
}
for(s=[-1,1]) {
  part(str(s<0?"Left":"Right"," fixed sector"),at=[fixed_x(s),0,t],rotate=[90,0,90]) difference() {
    union() {
      hull() {
        rect([base_depth,10]);
        for(a=[0:5:75])translate(arc(a,radius+12))circle(r=1);
        translate([py,pivot_height-t])circle(r=12);
      }
      for(y=[40,base_depth-40])translate([y-10,-t])rect([20,t]);
    }
    translate([py,pivot_height-t])circle(d=bolt_diameter+0.3);
    union() {
      polygon(concat([for(a=[10:1:65])arc(a,radius+(bolt_diameter+0.5)/2)],
        [for(a=[65:-1:10])arc(a,radius-(bolt_diameter+0.5)/2)]));
      for(a=[10,65])translate(arc(a))circle(d=bolt_diameter+0.5);
    }
  }
  part(str(s<0?"Left":"Right"," moving flange"),at=[flange_x(s),py,pivot_height],rotate=[90,-angle,90]) difference() {
    union() {
      hull() {circle(r=10);translate([depth-5,0])rect([10,20],center=true);}
      for(u=[depth/4,3*depth/4])translate([u-6,v])rect([12,t]);
    }
    for(u=[0,radius])translate([u,0])circle(d=bolt_diameter+0.3);
  }
}
part("Tilting deck",at=moving(0,v)+[-width/2,0,0],rotate=[angle,0,0]) difference() {
  finger_rect([width,depth],["out","flat","flat","flat"]);
  for(s=[-1,1],u=[depth/4,3*depth/4])translate([flange_x(s)+t/2+width/2,u])rect([t+clearance,12+clearance],center=true);
}
part("Front lip",at=moving(t,v)+[-width/2,0,0],rotate=[90+angle,0,0])
  finger_rect([width,lip_height],["in","flat","flat","flat"]);
echo("hardware",[for(s=[-1,1],u=[0,radius])let(p=moving(u),lo=min(fixed_x(s),flange_x(s))-1,
  hi=max(fixed_x(s),flange_x(s))+t+1)[[lo,p[1],p[2]],[hi,p[1],p[2]],bolt_diameter,"steel",24]]);
