// Earring screen: a plain perforated panel plugs into a broad foot.
// Hole pairs, row spacing and sheet thickness are independent controls.
// Assembly: test the slot fit, then glue the panel tabs into the foot.

use <kerf/tabs>

/* [Display] */
width = 180; // [120:5:300]
height = 200; // [120:5:320]
pairs = 5; // [2:1:8]
rows = 6; // [2:1:10]
hole = 2.5; // [2:0.1:4]
pair_spacing = 9; // [6:1:12]
foot_depth = 80; // [60:5:130]

/* [Material] */
$thickness = 3; // [2:0.5:6]
$kerf = 0.15; // [0:0.01:0.3]
clearance = 0.15; // [0:0.05:0.4]

/* [Hidden] */
$material = "plywood";
t = $thickness;
assert(width / pairs > pair_spacing + hole + 5, "Reduce pairs or increase width");
assert((height - 40) / max(1, rows - 1) > hole + 5, "Reduce rows or increase height");
step("Lay the foot flat")
  part("Foot", at = [-10, 0, 0]) difference() {
    rect([width + 20, foot_depth], r = 5);
    translate([10, foot_depth / 2]) slots(width, clearance = clearance);
  }
step("Test the slot fit, then glue the screen tabs into the foot")
  part("Screen", at = [0, foot_depth / 2 + t / 2, t], rotate = [90, 0, 0]) difference() {
    union() { rect([width, height], r = 5); tabs(width); }
    for (i = [0:pairs - 1], j = [0:rows - 1], s = [-1, 1])
      translate([width * (i + 0.5) / pairs + s * pair_spacing / 2, 25 + j * (height - 40) / (rows - 1)]) circle(d = hole);
  }
