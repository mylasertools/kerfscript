// Beam balance: a stable pivoted beam with two level, cord-suspended pans.
// Glue the fork uprights into the foot and glue a rim onto each pan.
// Fit the beam on a loose pivot bolt, then tie three equal cords per pan.
// The tilt control demonstrates motion; it does not calculate equilibrium.

/* [Balance] */
arm = 105; // [80:5:145]
pivot_height = 165; // [125:5:220]
drop = 95; // [65:5:130]
pan_diameter = 70; // [50:5:90]
base_width = 150; // [120:5:200]
base_depth = 100; // [80:5:140]
tilt = 7; // [-12:1:12]

/* [Material] */
$thickness = 3; // [2:0.5:6]
$kerf = 0.15; // [0:0.01:0.3]
clearance = 0.15; // [0:0.05:0.4]
pin_diameter = 3; // [3:0.5:5]
washer_gap = 0.5; // [0.3:0.1:1]

/* [Hidden] */
$material = "plywood";
t = $thickness;
r = pan_diameter / 2;
front = -t / 2 - washer_gap;
back = t / 2 + washer_gap + t;
assert(abs(tilt) <= 12, "Tilt must stay between -12 and 12 degrees");
assert(pivot_height - arm * sin(12) - drop > 2 * t + 10, "Raise the pivot or shorten the suspension");
assert(arm * cos(12) > r + 22, "Leave room between the pans and the fork");
assert(base_depth > pan_diameter + t + 12, "Widen the foot beneath the pans");
function end(s) = [s * arm * cos(tilt), 0, pivot_height + s * arm * sin(tilt)];
function hanger(s) = end(s) + [0, -t / 2 - 6, 0];
function pan(s) = hanger(s) - [0, 0, drop];
function tie(s, k) = pan(s) + [(r - 6) * cos(120 * k), (r - 6) * sin(120 * k), t];
step("Glue the fork uprights into the foot") {
  // The foot cuts the slots for the uprights' tabs
  part("Foot", at = [0, 0, 0], slots = ["Fork upright"], clearance = clearance)
    rect([base_width, base_depth], center = true, r = 6);
  part("Fork upright", qty = 2, at = [[0, front, t], [0, back, t]], rotate = [90, 0, 0]) difference() {
    union() {
      hull() { translate([-14, 0]) rect([28, 8]); translate([0, pivot_height - t]) circle(r = 12); }
      translate([-6, -t]) rect([12, t]);
    }
    translate([0, pivot_height - t]) circle(d = pin_diameter + 0.3);
  }
}
step("Hang the beam on a loose pivot bolt, with a hook at each end") {
  part("Balance beam", at = [0, t / 2, pivot_height], rotate = [90, -tilt, 0]) difference() {
    union() {
      hull() { for (x = [-arm, arm]) translate([x, 0]) circle(r = 9); }
      hull() { circle(r = 9); translate([0, -14]) circle(r = 10); }
    }
    circle(d = pin_diameter + 0.3);
    for (x = [-arm, arm]) translate([x, 0]) circle(d = 4);
  }
  hardware("steel", [0, front - t - 1, pivot_height], [0, back + 1, pivot_height], pin_diameter, label = "pivot bolt");
  for (s = [-1, 1]) hardware("steel", hanger(s), end(s) + [0, t / 2 + 1, 0], 3, label = "hook");
}
step("Glue a rim on each pan and tie it on with three equal cords")
  for (s = [-1, 1]) {
    part(str(s < 0 ? "Left" : "Right", " pan floor"), at = pan(s)) difference() {
      circle(r = r);
      for (k = [0:2]) translate([(r - 6) * cos(120 * k), (r - 6) * sin(120 * k)]) circle(d = 2.6);
    }
    part(str(s < 0 ? "Left" : "Right", " pan rim"), glue = str(s < 0 ? "Left" : "Right", " pan floor"))
      difference() { circle(r = r); circle(r = r - 4); }
    for (k = [0:2]) hardware("cord", hanger(s), tie(s, k), 1.2, sides = 12);
  }
