// Shape tags: gift tags, place cards and labels in the shape you pick, one
// for each name, every name sized to fill its tag. The shapes come from
// kerf/shapes, and the settings that matter for one shape only show when it
// is picked.

use <kerf/shapes>

/* [Tags] */
// Names, separated by commas
names = "Mila, Theo, Grandma, Oliver";
// Small text under each name, leave empty for none
line2 = "with love"; // 24
// Shape of each tag
shape = "heart"; // [heart:Heart, tag:Luggage tag, cloud:Cloud, banner:Banner, scalloped:Scalloped circle, shield:Shield]
// Width of each tag
size = 80; // [50:2:140]
// Hole for a ribbon
hole = 5; // [3:0.5:8] when shape == "tag" || shape == "heart" || shape == "scalloped"
// Scallops round the edge
scallops = 16; // [10:1:28] when shape == "scalloped"
// A scored line round the inside of the edge
border = true;

/* [Material] */
// Sheet thickness
$thickness = 3; // [2:0.5:6]
// Beam width
$kerf = 0.15; // [0:0.01:0.3]

/* [Hidden] */
$material = "plywood";
$fn = 64;

function trim(s) =
  len(s) == 0 ? s
  : s[0] == " " ? trim(slice(s, 1))
  : s[len(s) - 1] == " " ? trim(slice(s, 0, len(s) - 1))
  : s;

list = [for (n = split(names, ",")) if (trim(n) != "") trim(n)];

// Each shape's height for its width, the box the name fits in and where
// that box is centred (as parts of the width), and where the hole goes
function look(s) =
  s == "tag" ? {h = 0.5, box = [0.62, 0.36], at = [0.09, 0], hole = [-0.33, 0]}
  : s == "heart" ? {h = 0.9, box = [0.5, 0.26], at = [0, -0.07], hole = [0, 0.13]}
  : s == "cloud" ? {h = 0.62, box = [0.62, 0.26], at = [0, -0.04]}
  : s == "banner" ? {h = 0.36, box = [0.58, 0.24], at = [0, 0]}
  : s == "scalloped" ? {h = 1, box = [0.6, 0.34], at = [0, -0.04], hole = [0, 0.32]}
  : {h = 1.15, box = [0.6, 0.36], at = [0, 0.1]};

l = look(shape);
w = size;
h = size * l.h;

module blank() {
  if (shape == "tag") tag([w, h], hole = 0);
  else if (shape == "heart") heart([w, h]);
  else if (shape == "cloud") cloud([w, h]);
  else if (shape == "banner") banner([w, h]);
  else if (shape == "scalloped") scalloped(w, scallops);
  else shield([w, h]);
}

module card(name) {
  box = l.box * w;
  at = l.at * w;
  two = line2 != "";
  difference() {
    blank();
    if (!is_undef(l.hole)) translate(l.hole * w) circle(d = hole);
  }
  engrave() {
    // The name on the upper part of the box, its capitals centred there
    translate(at + [0, two ? box[1] * 0.18 : 0])
      text(name, fit = [box[0], box[1] * (two ? 0.5 : 0.62)], halign = "center", valign = "cap");
    if (two)
      translate(at - [0, box[1] * 0.36])
        text(line2, fit = [box[0] * 0.8, box[1] * 0.16], halign = "center", valign = "cap");
  }
  if (border) score() outline() offset(r = -max(2.5, w * 0.035)) blank();
}

for (name = list) part(name) card(name);
