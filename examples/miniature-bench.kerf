// Miniature bench: a small seat and back tab into two shaped side supports.
// This is a display miniature. Dimensions are not a human seating design.
// Assembly: fit the seat and back between the sides, then glue the joints.

use <kerf/tabs>

/* [Bench] */
width = 150; // [80:5:240]
depth = 58; // [40:2:90]
seat_height = 40; // [25:2:65]
back_height = 47; // [25:2:75]

/* [Material] */
$thickness = 3; // [2:0.5:6]
$kerf = 0.15; // [0:0.01:0.3]
clearance = 0.15; // [0:0.05:0.4]

/* [Hidden] */
$material = "plywood";
t = $thickness;
span = width - 2 * t;
back_at = depth - 1.5 * t;
total = seat_height + t + back_height + 7;
part("Side support", qty = 2, at = [[0, 0, 0], [width - t, 0, 0]], rotate = [90, 0, 90]) difference() {
  polygon([[0,0],[depth,0],[depth,total],[depth-12,total],[depth-12,seat_height+14],[0,seat_height+14]]);
  translate([0, seat_height + t / 2]) slots(depth, clearance = clearance);
  translate([back_at, seat_height + t]) rotate(90) slots(back_height, clearance = clearance);
  translate([depth / 2, 8]) rect([depth - 24, 16], center = true, r = 3);
}
part("Seat", at = [t, 0, seat_height]) tab_rect([span, depth], [false, true, false, true]);
part("Back", at = [t, back_at + t / 2, seat_height + t], rotate = [90, 0, 0]) difference() {
  tab_rect([span, back_height], [false, true, false, true]);
  for (j = [1:2]) translate([10, back_height * j / 3 - 1.5]) rect([span - 20, 3], r = 1.5);
}
