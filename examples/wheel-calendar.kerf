// Wheel calendar: three independent numeric/date wheels on a tabbed stand.
// Glue the backboard into the foot, then bolt on the wheels with washers.
// Read the value beneath each fixed pointer. Set weekday, month and day by
// hand; there is no automatic month-length or leap-year mechanism.

use <kerf/tabs>

/* [Wheels] */
day_radius = 75; // [65:5:95]
month_radius = 48; // [40:2:60]
week_radius = 40; // [35:1:50]
day = 17; // [1:1:31]
month = 11; // [1:1:12]
weekday = 1; // [1:1:7]

/* [Material] */
$thickness = 3; // [2:0.5:6]
$kerf = 0.15; // [0:0.01:0.3]
clearance = 0.15; // [0:0.05:0.4]
pin_diameter = 3; // [3:0.5:5]
washer_gap = 0.6; // [0.3:0.1:1]

/* [Hidden] */
$material = "plywood";
t = $thickness;
m = 12;
radii = [day_radius, month_radius, week_radius];
values = [day, month, weekday];
counts = [31, 12, 7];
titles = ["DAY", "MONTH", "WEEK"];
weeks = ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"];
centres = [day_radius + m, 2 * day_radius + 3 * m + month_radius, 2 * (day_radius + month_radius) + 5 * m + week_radius];
w = 2 * sum(radii) + 6 * m;
h = 2 * max(radii) + 2 * m + 8;
assert(day_radius >= 65, "Use a larger day wheel for readable numbers");
part("Foot", at = [-6, -40, 0]) difference() {
  rect([w + 12, 80], r = 5);
  translate([6, 40 + t / 2]) slots(w, count = 4, width = 20, clearance = clearance);
}
part("Backboard", at = [0, t, t], rotate = [90, 0, 0]) {
  difference() {
    union() { rect([w, h]); tabs(w, count = 4, width = 20); }
    for (i = [0:2]) translate([centres[i], radii[i] + m]) circle(d = pin_diameter + 0.3);
  }
  score() for (i = [0:2]) {
    x = centres[i]; z = 2 * radii[i] + m;
    polyline([[x - 3, z + 9], [x, z + 3], [x + 3, z + 9]]);
    translate([x, z + 11]) text(titles[i], size = 4, halign = "center");
  }
}
for (i = [0:2]) part(str(titles[i], " wheel"), at = [centres[i], -washer_gap, radii[i] + m + t], rotate = [90, -(values[i] - 1) * 360 / counts[i], 0]) {
  difference() { circle(r = radii[i]); circle(d = pin_diameter + 0.3); }
  score() for (j = [0:counts[i] - 1]) rotate(90 - j * 360 / counts[i]) translate([radii[i] - 8, 0]) rotate(-90)
    text(i == 2 ? weeks[j] : str(j + 1), size = i == 0 ? 4.4 : 4.5, halign = "center", valign = "center");
}
echo("hardware", [for (i = [0:2]) [[centres[i], -washer_gap - t - 2, radii[i] + m + t],
  [centres[i], t + 2, radii[i] + m + t], pin_diameter, "steel", 24]]);
