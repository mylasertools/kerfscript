// Loom card: a reusable small weaving frame with rounded yarn notches.
// Warp count and pitch generate equal notches along both short edges.
// Assembly: wind a continuous warp between opposite notches. The second
// part is a blunt shuttle with two open yarn pockets, not a cutting tool.

/* [Weaving] */
warp_count = 17; // [7:1:31]
pitch = 6; // [4:0.5:10]
length = 180; // [100:5:280]
border = 18; // [12:1:28]
notch_width = 2; // [1.5:0.1:3]

/* [Material] */
$thickness = 3; // [2:0.5:6]
$kerf = 0.15; // [0:0.01:0.3]

/* [Hidden] */
$material = "plywood";
width = (warp_count - 1) * pitch + 2 * border;
assert(pitch >= notch_width + 2, "Leave at least 2 mm between yarn notches");
assert(length > 2 * border + 35, "Increase frame length or reduce border");
part("Loom", at = [0, 0, 0]) difference() {
  rect([width, length], r = 6);
  translate([border, border]) rect([width - 2 * border, length - 2 * border], r = 5);
  for (i = [0:warp_count - 1], y = [0, length]) translate([border + i * pitch, y]) rect([notch_width, 12], center = true, r = notch_width / 2);
}
part("Shuttle", at = [width + 15, 0, 0]) difference() {
  rect([22, min(length, 160)], r = 9);
  for (y = [0, min(length, 160)]) translate([11, y]) rect([7, 28], center = true, r = 3.5);
}
