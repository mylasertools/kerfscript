{
  "name": "@mylasertools/kerfscript",
  "version": "0.8.0",
  "description": "KerfScript: a programming language and library for laser-cutting generators. Write parametric 2D parts with cut, score and engrave layers, kerf compensation and joinery, then turn settings into SVG or DXF cut files from Node.js, the browser, the command line or WebAssembly.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "MyLaserTools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylasertools/kerfscript.git"
  },
  "bugs": "https://github.com/mylasertools/kerfscript/issues",
  "keywords": [
    "kerfscript",
    "laser-cutting",
    "parametric",
    "cad",
    "programming-language",
    "svg",
    "dxf",
    "finger-joints",
    "living-hinge",
    "kerf",
    "generator",
    "laser-cutter",
    "svg-generator",
    "dxf-generator",
    "language-server",
    "lsp"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./highlight": {
      "import": {
        "types": "./dist/highlight.d.ts",
        "default": "./dist/highlight.js"
      },
      "require": {
        "types": "./dist/highlight.d.cts",
        "default": "./dist/highlight.cjs"
      }
    },
    "./signatures": {
      "import": {
        "types": "./dist/signatures.d.ts",
        "default": "./dist/signatures.js"
      },
      "require": {
        "types": "./dist/signatures.d.cts",
        "default": "./dist/signatures.cjs"
      }
    },
    "./language": {
      "import": {
        "types": "./dist/language.d.ts",
        "default": "./dist/language.js"
      },
      "require": {
        "types": "./dist/language.d.cts",
        "default": "./dist/language.cjs"
      }
    },
    "./libraries": {
      "import": {
        "types": "./dist/libraries.d.ts",
        "default": "./dist/libraries.js"
      },
      "require": {
        "types": "./dist/libraries.d.cts",
        "default": "./dist/libraries.cjs"
      }
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "kerf": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/kerfscript.wasm",
    "README.md",
    "docs",
    "LANGUAGE.md",
    "LICENSE",
    "COMMERCIAL-LICENSE.md",
    "THIRD-PARTY-NOTICES.md",
    "fonts/OFL.txt",
    "CHANGELOG.md",
    "TRADEMARKS.md",
    "CLA.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/stdlib.mjs && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "verify:fixtures": "node scripts/verify-models.mjs",
    "snapshots": "npm run build && node scripts/snapshots.mjs",
    "check": "npm run build && npm test",
    "examples": "node scripts/examples.mjs",
    "site": "npm run build && npm --prefix site run build",
    "site:serve": "npm --prefix site run preview",
    "prepack": "npm run check",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "compat": "node scripts/compat.mjs",
    "wasm": "node scripts/wasm.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "clipper2-ts": "2.0.1-18",
    "esbuild": "0.25.12",
    "marked": "15.0.12",
    "opentype.js": "1.3.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "homepage": "https://kerfscript.mylasertools.com"
}
